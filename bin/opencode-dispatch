#!/bin/sh
# Backend dispatcher for OpenChamber SSH-managed remotes.
#
# The desktop starts one remote `openchamber serve --port <N>` per SSH
# instance entry (remoteOpenchamber.preferredPort), and that server spawns
# this script as its agent backend ($opencodeBinary). We walk the ancestor
# process chain for the managing server's --port: the pi port gets the pi
# shim, the mcode port (pi port + 1) gets the openchamber-mcode shim,
# anything else gets the real opencode. This makes the agent backend
# selectable per instance entry without forking OpenChamber.
#
# Install: point the REMOTE host's ~/.config/openchamber/settings.json
# "opencodeBinary" at this script. Create one desktop SSH instance per
# backend, each with its own remoteOpenchamber.preferredPort:
#   pi    -> 57124
#   mcode -> 57125 (pi + 1; needs the openchamber-mcode repo cloned as a
#                   sibling of this repo, or OCMC_MCODE_SHIM set)
#
# Env overrides: ANTECHAMBER_PI_PORT (default 57124), ANTECHAMBER_PI_SHIM (default:
# sibling bin/opencode-pi), OCMC_MCODE_PORT (default: ANTECHAMBER_PI_PORT + 1),
# OCMC_MCODE_SHIM (default: ../../openchamber-mcode/bin/opencode-mcode
# relative to this script), ANTECHAMBER_REAL_OPENCODE (default: first opencode on
# the candidate paths that is not this dispatcher — safe when a symlink
# named "opencode" points back at us after the real CLI was removed).

set -u

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PI_PORT="${ANTECHAMBER_PI_PORT:-57124}"
PI_SHIM="${ANTECHAMBER_PI_SHIM:-$SCRIPT_DIR/opencode-pi}"
MCODE_PORT="${OCMC_MCODE_PORT:-$((PI_PORT + 1))}"
MCODE_SHIM="${OCMC_MCODE_SHIM:-$SCRIPT_DIR/../../openchamber-mcode/bin/opencode-mcode}"

find_real_opencode() {
  self=$(readlink -f "$0" 2>/dev/null || echo "$0")
  for c in ${ANTECHAMBER_REAL_OPENCODE:-} "$HOME/.opencode/bin/opencode" "$HOME/.bun/bin/opencode" "$(command -v opencode 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] || continue
    target=$(readlink -f "$c" 2>/dev/null || echo "$c")
    [ "$target" = "$self" ] && continue
    echo "$c"
    return 0
  done
  return 1
}

REAL_OPENCODE=$(find_real_opencode || true)

pid=$$
while [ -n "$pid" ] && [ "$pid" != "1" ]; do
  args=$(ps -o args= -p "$pid" 2>/dev/null) || break
  case "$args" in
    *@openchamber*--port*)
      port=$(echo "$args" | sed -n "s/.*--port[ =]\([0-9]*\).*/\1/p")
      if [ "$port" = "$PI_PORT" ]; then
        exec "$PI_SHIM" "$@"
      fi
      if [ "$port" = "$MCODE_PORT" ]; then
        if [ -x "$MCODE_SHIM" ]; then
          exec "$MCODE_SHIM" "$@"
        fi
        echo "opencode-dispatch: mcode shim missing or not executable: $MCODE_SHIM (set OCMC_MCODE_SHIM)" >&2
        exit 1
      fi
      [ -n "$REAL_OPENCODE" ] && exec "$REAL_OPENCODE" "$@"
      echo "opencode-dispatch: real opencode not found (removed?), and port $port != pi port $PI_PORT" >&2
      exit 1
      ;;
  esac
  pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d " ")
done

[ -n "$REAL_OPENCODE" ] && exec "$REAL_OPENCODE" "$@"
echo "opencode-dispatch: real opencode not found (removed?)" >&2
exit 1
