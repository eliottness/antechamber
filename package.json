{
  "name": "antechamber",
  "version": "1.0.4",
  "description": "OpenCode-compatible HTTP/SSE server that lets OpenChamber drive the pi coding agent (and OmO) over RPC",
  "type": "module",
  "license": "MIT",
  "author": "Eliott Bouhana",
  "contributors": [
    "xiuli.qz (original openchamber-pi-connector)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliottness/antechamber.git"
  },
  "bugs": {
    "url": "https://github.com/eliottness/antechamber/issues"
  },
  "homepage": "https://github.com/eliottness/antechamber#readme",
  "keywords": [
    "openchamber",
    "opencode",
    "pi",
    "coding-agent",
    "omo",
    "adapter"
  ],
  "files": [
    "dist",
    "bin/opencode-antechamber",
    "bin/opencode-pi",
    "extensions/omo-dag/package.json",
    "extensions/omo-dag/icon.svg",
    "extensions/omo-dag/panel/index.html",
    "extensions/omo-dag/panel/main.js",
    "extensions/omo-dag/service/main.js",
    "extensions/omo-dag/README.md",
    "extensions/omo-dag/docs/DESIGN.md",
    "extensions/omo-work/package.json",
    "extensions/omo-work/status/index.html",
    "extensions/omo-work/status/main.js",
    "extensions/omo-work/service/main.js",
    "extensions/omo-work/README.md",
    "extensions/omo-compat/package.json",
    "extensions/omo-compat/icon.svg",
    "extensions/omo-compat/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "antechamber": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/cli.js', 0o755)\" && npm run build:extension",
    "build:extension": "tsx extensions/omo-dag/scripts/build.ts && tsx extensions/omo-work/scripts/build.ts",
    "pack:extension": "tsx extensions/omo-dag/scripts/pack.ts",
    "pack:work-extension": "tsx extensions/omo-work/scripts/pack.ts",
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p extensions/omo-dag/tsconfig.json && tsc -p extensions/omo-work/tsconfig.json",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "tsx --test --import ./test/setup.ts test/*.test.ts extensions/*/test/*.test.ts",
    "probe": "tsx contrib/probe.ts",
    "smoke": "tsx contrib/smoke.ts",
    "omo-smoke": "tsx contrib/omo/omo-smoke.ts",
    "model-smoke": "tsx contrib/model-consistency.ts",
    "v2-smoke": "tsx contrib/v2-smoke.ts",
    "replay": "tsx contrib/replay/transcripts.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@openchamber/sdk": "1.24.2",
    "@openchamber/sdk-v2": "npm:@openchamber/sdk@2.5.0",
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  }
}
