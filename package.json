{
  "name": "antechamber",
  "version": "0.1.0",
  "description": "OpenCode-compatible HTTP/SSE server that lets OpenChamber drive the pi coding agent (and OmO) over RPC",
  "type": "module",
  "license": "MIT",
  "bin": {
    "antechamber": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --import ./test/setup.ts test/*.test.ts",
    "probe": "tsx contrib/probe.ts",
    "smoke": "tsx contrib/smoke.ts",
    "omo-smoke": "tsx contrib/omo-smoke.ts",
    "model-smoke": "tsx contrib/model-consistency.ts",
    "v2-smoke": "tsx contrib/v2-smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  }
}
